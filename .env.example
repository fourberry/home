# 문의 전송 프록시 설정 — .env 로 복사해서 채우세요
# (.env 는 .gitignore 에 포함되어 있습니다)

# 메시지 발송 API 주소 (TLS 적용 시 https 로 변경)
MESSAGE_API_BASE=http://59.15.89.190:8061

# 발송 API 키 — 서버 전용, 절대 이 파일(.env.example)에 실제 값을 적지 마세요.
# 이 파일은 저장소에 커밋됩니다. 실제 키는 .env 또는 Worker Secret 에만 넣습니다.
MESSAGE_API_KEY=여기에_발송_API_키

# 문의 메일 수신자 (쉼표 구분)
CONTACT_RECIPIENTS=damon@fourberry.co.kr,briskly0415@fourberry.co.kr,dodam@fourberry.co.kr,hjyoon@fourberry.co.kr,hahahagh@fourberry.co.kr,jmchoi@fourberry.co.kr,won567567@fourberry.co.kr,lsj8376@fourberry.co.kr

# 프론트가 호출할 엔드포인트
#  - Nitro 서버가 있는 배포: /api/contact  (기본값, 비워두면 됨)
#  - GitHub Pages 정적 배포: Cloudflare Worker 주소로 지정
# NUXT_PUBLIC_CONTACT_ENDPOINT=https://fb-contact.<계정>.workers.dev

# 홈페이지 채팅 창(plum 공개 채팅) 주소 — 비워 두면 창을 그리지 않습니다.
#  - 로컬 가짜 응답(npm run dev 전용): /dev-webchat/v1/wc_dev00000000000000000
#  - 실제 plum 시험: plum 콘솔의 시험용 웹 채팅 설정(허용 origin http://localhost:4000) 주소
#  - 운영 배포는 GitHub 저장소 변수 CHAT_ENDPOINT 를 워크플로가 넣습니다.
#  - 지금은 주소에 ?chat_preview=1 을 붙여야 버튼이 보입니다.
# NUXT_PUBLIC_CHAT_ENDPOINT=/dev-webchat/v1/wc_dev00000000000000000
