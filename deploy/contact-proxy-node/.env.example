# 문의 프록시 환경변수 — .env 로 복사해서 채우세요 (.env 는 서버에만 두고 커밋 금지)

# 프록시가 리스닝할 포트 (nginx 등에서 이 포트로 프록시)
PORT=8787

# 발송 API 주소 (비 TLS)
MESSAGE_API_BASE=http://59.15.89.190:8061

# 발송 API 키 — 서버 전용. 절대 클라이언트/저장소에 노출하지 마세요.
MESSAGE_API_KEY=여기에_발송_API_키

# 문의 메일 수신자 (쉼표 구분)
CONTACT_RECIPIENTS=briskly0415@fourberry.co.kr,won567567@fourberry.co.kr,lsj8376@fourberry.co.kr

# 허용할 사이트 origin (CORS). 운영 사이트 도메인과 정확히 일치해야 합니다.
ALLOWED_ORIGIN=https://www.fourberry.co.kr
